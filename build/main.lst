 199:Core/Src/main.c **** #define TRIG_PORT GPIOA
 200:Core/Src/main.c **** 
 201:Core/Src/main.c **** void HAL_TIM_IC_CaptureCallback(TIM_HandleTypeDef *htim)
 202:Core/Src/main.c **** {
 203:Core/Src/main.c ****   if (htim->Channel == HAL_TIM_ACTIVE_CHANNEL_1 && htim->Instance == TIM1) // if the interrupt sour
 204:Core/Src/main.c ****   {
ARM GAS  /tmp/ccLtr8El.s 			page 5


 205:Core/Src/main.c ****     if (Is_First_Captured == 0) // if the first value is not captured
 206:Core/Src/main.c ****     {
 207:Core/Src/main.c ****       IC_Val1 = HAL_TIM_ReadCapturedValue(htim, TIM_CHANNEL_1); // read the first value
 208:Core/Src/main.c ****       Is_First_Captured = 1;                                    // set the first captured as true
 209:Core/Src/main.c ****       // Now change the polarity to falling edge
 210:Core/Src/main.c ****       __HAL_TIM_SET_CAPTUREPOLARITY(htim, TIM_CHANNEL_1, TIM_INPUTCHANNELPOLARITY_FALLING);
 211:Core/Src/main.c ****     }
 212:Core/Src/main.c **** 
 213:Core/Src/main.c ****     else if (Is_First_Captured == 1) // if the first is already captured
 214:Core/Src/main.c ****     {
 215:Core/Src/main.c ****       IC_Val2 = HAL_TIM_ReadCapturedValue(htim, TIM_CHANNEL_1); // read second value
 216:Core/Src/main.c ****       __HAL_TIM_SET_COUNTER(htim, 0);                           // reset the counter
 217:Core/Src/main.c **** 
 218:Core/Src/main.c ****       if (IC_Val2 > IC_Val1)
 219:Core/Src/main.c ****       {
 220:Core/Src/main.c ****         Difference = IC_Val2 - IC_Val1;
 221:Core/Src/main.c ****       }
 222:Core/Src/main.c **** 
 223:Core/Src/main.c ****       else if (IC_Val1 > IC_Val2)
 224:Core/Src/main.c ****       {
 225:Core/Src/main.c ****         Difference = (0xffff - IC_Val1) + IC_Val2;
 226:Core/Src/main.c ****       }
 227:Core/Src/main.c **** 
 228:Core/Src/main.c ****       Distance = Difference * .034 / 2;
 229:Core/Src/main.c ****       Is_First_Captured = 0; // set it back to false
 230:Core/Src/main.c **** 
 231:Core/Src/main.c ****       if (isAutonomous)
 232:Core/Src/main.c ****       {
 233:Core/Src/main.c ****         if(auto_ctl.looKingDirection == FRONT) {
 234:Core/Src/main.c ****           auto_ctl.frontDistance = Distance;
 235:Core/Src/main.c ****         }
 236:Core/Src/main.c ****         else if (!auto_ctl.leftDistance && auto_ctl.looKingDirection == LEFT)
 237:Core/Src/main.c ****         {
 238:Core/Src/main.c ****           // leftDistance = Distance;
 239:Core/Src/main.c ****           auto_ctl.leftDistance = Distance;
 240:Core/Src/main.c ****         }
 241:Core/Src/main.c ****         else if (!auto_ctl.rightDistance && auto_ctl.looKingDirection == RIGHT)
 242:Core/Src/main.c ****         {
 243:Core/Src/main.c ****           // rightDistance = Distance;
 244:Core/Src/main.c ****           auto_ctl.rightDistance = Distance;
 245:Core/Src/main.c ****         }
 246:Core/Src/main.c ****       }
 247:Core/Src/main.c **** 
 248:Core/Src/main.c ****       // set polarity to rising edge
 249:Core/Src/main.c ****       __HAL_TIM_SET_CAPTUREPOLARITY(htim, TIM_CHANNEL_1, TIM_INPUTCHANNELPOLARITY_RISING);
 250:Core/Src/main.c ****       __HAL_TIM_DISABLE_IT(&htim1, TIM_IT_CC1);
 251:Core/Src/main.c ****     }
 252:Core/Src/main.c ****   }
 253:Core/Src/main.c **** }
