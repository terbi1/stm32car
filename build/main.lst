 187:Core/Src/main.c **** uint32_t IC_Val1 = 0;
 188:Core/Src/main.c **** uint32_t IC_Val2 = 0;
 189:Core/Src/main.c **** uint32_t Difference = 0;
 190:Core/Src/main.c **** uint8_t Is_First_Captured = 0; // is the first value captured ?
 191:Core/Src/main.c **** uint32_t Distance = 400;
 192:Core/Src/main.c **** uint32_t leftDistance = 0;
 193:Core/Src/main.c **** uint32_t rightDistance = 0;
 194:Core/Src/main.c **** 
 195:Core/Src/main.c **** #define TRIG_PIN GPIO_PIN_7
 196:Core/Src/main.c **** #define TRIG_PORT GPIOA
 197:Core/Src/main.c **** 
 198:Core/Src/main.c **** void HAL_TIM_IC_CaptureCallback(TIM_HandleTypeDef *htim)
 199:Core/Src/main.c **** {
 200:Core/Src/main.c ****   if (htim->Channel == HAL_TIM_ACTIVE_CHANNEL_1 && htim->Instance == TIM1) // if the interrupt sour
 201:Core/Src/main.c ****   {
 202:Core/Src/main.c ****     if (Is_First_Captured == 0) // if the first value is not captured
 203:Core/Src/main.c ****     {
 204:Core/Src/main.c ****       IC_Val1 = HAL_TIM_ReadCapturedValue(htim, TIM_CHANNEL_1); // read the first value
ARM GAS  /tmp/ccKW35Vz.s 			page 5


 205:Core/Src/main.c ****       Is_First_Captured = 1;                                    // set the first captured as true
 206:Core/Src/main.c ****       // Now change the polarity to falling edge
 207:Core/Src/main.c ****       __HAL_TIM_SET_CAPTUREPOLARITY(htim, TIM_CHANNEL_1, TIM_INPUTCHANNELPOLARITY_FALLING);
 208:Core/Src/main.c ****     }
 209:Core/Src/main.c **** 
 210:Core/Src/main.c ****     else if (Is_First_Captured == 1) // if the first is already captured
 211:Core/Src/main.c ****     {
 212:Core/Src/main.c ****       IC_Val2 = HAL_TIM_ReadCapturedValue(htim, TIM_CHANNEL_1); // read second value
 213:Core/Src/main.c ****       __HAL_TIM_SET_COUNTER(htim, 0);                           // reset the counter
 214:Core/Src/main.c **** 
 215:Core/Src/main.c ****       if (IC_Val2 > IC_Val1)
 216:Core/Src/main.c ****       {
 217:Core/Src/main.c ****         Difference = IC_Val2 - IC_Val1;
 218:Core/Src/main.c ****       }
 219:Core/Src/main.c **** 
 220:Core/Src/main.c ****       else if (IC_Val1 > IC_Val2)
 221:Core/Src/main.c ****       {
 222:Core/Src/main.c ****         Difference = (0xffff - IC_Val1) + IC_Val2;
 223:Core/Src/main.c ****       }
 224:Core/Src/main.c **** 
 225:Core/Src/main.c ****       Distance = Difference * .034 / 2;
 226:Core/Src/main.c ****       Is_First_Captured = 0; // set it back to false
 227:Core/Src/main.c **** 
 228:Core/Src/main.c ****       if (isAutonomous)
 229:Core/Src/main.c ****       {
 230:Core/Src/main.c ****         if(auto_ctl.looKingDirection == FRONT) {
 231:Core/Src/main.c ****           auto_ctl.frontDistance = Distance;
 232:Core/Src/main.c ****         }
 233:Core/Src/main.c ****         else if (!auto_ctl.leftDistance && auto_ctl.looKingDirection == LEFT)
 234:Core/Src/main.c ****         {
 235:Core/Src/main.c ****           // leftDistance = Distance;
 236:Core/Src/main.c ****           auto_ctl.leftDistance = Distance;
 237:Core/Src/main.c ****         }
 238:Core/Src/main.c ****         else if (!auto_ctl.rightDistance && auto_ctl.looKingDirection == RIGHT)
 239:Core/Src/main.c ****         {
 240:Core/Src/main.c ****           // rightDistance = Distance;
 241:Core/Src/main.c ****           auto_ctl.rightDistance = Distance;
 242:Core/Src/main.c ****         }
 243:Core/Src/main.c ****       }
 244:Core/Src/main.c **** 
 245:Core/Src/main.c ****       // set polarity to rising edge
 246:Core/Src/main.c ****       __HAL_TIM_SET_CAPTUREPOLARITY(htim, TIM_CHANNEL_1, TIM_INPUTCHANNELPOLARITY_RISING);
 247:Core/Src/main.c ****       __HAL_TIM_DISABLE_IT(&htim1, TIM_IT_CC1);
 248:Core/Src/main.c ****     }
 249:Core/Src/main.c ****   }
 250:Core/Src/main.c **** }
