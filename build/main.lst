 151:Core/Src/main.c ****   {
 152:Core/Src/main.c ****     R_dt = now - R_t;
 153:Core/Src/main.c ****     R_t = now;
 154:Core/Src/main.c ****     ++right_ticks;
 155:Core/Src/main.c ****     // turning_ticks += (goingDirection == LEFT) ? 1:0;
 156:Core/Src/main.c ****     auto_ctl.turning_ticks += (auto_ctl.goingDirection == LEFT || auto_ctl.goingDirection == BACK) 
 157:Core/Src/main.c ****   }
 158:Core/Src/main.c **** 
