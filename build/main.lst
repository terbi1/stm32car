 191:Core/Src/main.c **** uint32_t IC_Val1 = 0;
 192:Core/Src/main.c **** uint32_t IC_Val2 = 0;
 193:Core/Src/main.c **** uint32_t Difference = 0;
 194:Core/Src/main.c **** uint8_t Is_First_Captured = 0; // is the first value captured ?
 195:Core/Src/main.c **** uint32_t Distance = 400;
 196:Core/Src/main.c **** uint32_t leftDistance = 0;
 197:Core/Src/main.c **** uint32_t rightDistance = 0;
 198:Core/Src/main.c **** 
 199:Core/Src/main.c **** #define TRIG_PIN GPIO_PIN_7
 200:Core/Src/main.c **** #define TRIG_PORT GPIOA
 201:Core/Src/main.c **** 
 202:Core/Src/main.c **** void HAL_TIM_IC_CaptureCallback(TIM_HandleTypeDef *htim)
 203:Core/Src/main.c **** {
 204:Core/Src/main.c ****   if (htim->Channel == HAL_TIM_ACTIVE_CHANNEL_1 && htim->Instance == TIM1) // if the interrupt sour
ARM GAS  /tmp/ccXCgOvN.s 			page 5


 205:Core/Src/main.c ****   {
 206:Core/Src/main.c ****     if (Is_First_Captured == 0) // if the first value is not captured
 207:Core/Src/main.c ****     {
 208:Core/Src/main.c ****       IC_Val1 = HAL_TIM_ReadCapturedValue(htim, TIM_CHANNEL_1); // read the first value
 209:Core/Src/main.c ****       Is_First_Captured = 1;                                    // set the first captured as true
 210:Core/Src/main.c ****       // Now change the polarity to falling edge
 211:Core/Src/main.c ****       __HAL_TIM_SET_CAPTUREPOLARITY(htim, TIM_CHANNEL_1, TIM_INPUTCHANNELPOLARITY_FALLING);
 212:Core/Src/main.c ****     }
 213:Core/Src/main.c **** 
 214:Core/Src/main.c ****     else if (Is_First_Captured == 1) // if the first is already captured
 215:Core/Src/main.c ****     {
 216:Core/Src/main.c ****       IC_Val2 = HAL_TIM_ReadCapturedValue(htim, TIM_CHANNEL_1); // read second value
 217:Core/Src/main.c ****       __HAL_TIM_SET_COUNTER(htim, 0);                           // reset the counter
 218:Core/Src/main.c **** 
 219:Core/Src/main.c ****       if (IC_Val2 > IC_Val1)
 220:Core/Src/main.c ****       {
 221:Core/Src/main.c ****         Difference = IC_Val2 - IC_Val1;
 222:Core/Src/main.c ****       }
 223:Core/Src/main.c **** 
 224:Core/Src/main.c ****       else if (IC_Val1 > IC_Val2)
 225:Core/Src/main.c ****       {
 226:Core/Src/main.c ****         Difference = (0xffff - IC_Val1) + IC_Val2;
 227:Core/Src/main.c ****       }
 228:Core/Src/main.c **** 
 229:Core/Src/main.c ****       Distance = Difference * .034 / 2;
 230:Core/Src/main.c ****       Is_First_Captured = 0; // set it back to false
 231:Core/Src/main.c **** 
 232:Core/Src/main.c ****       if (isAutonomous)
 233:Core/Src/main.c ****       {
 234:Core/Src/main.c ****         if(auto_ctl.looKingDirection == FRONT) {
 235:Core/Src/main.c ****           auto_ctl.frontDistance = Distance;
 236:Core/Src/main.c ****         }
 237:Core/Src/main.c ****         else if (!auto_ctl.leftDistance && auto_ctl.looKingDirection == LEFT)
 238:Core/Src/main.c ****         {
 239:Core/Src/main.c ****           // leftDistance = Distance;
 240:Core/Src/main.c ****           auto_ctl.leftDistance = Distance;
 241:Core/Src/main.c ****         }
 242:Core/Src/main.c ****         else if (!auto_ctl.rightDistance && auto_ctl.looKingDirection == RIGHT)
 243:Core/Src/main.c ****         {
 244:Core/Src/main.c ****           // rightDistance = Distance;
 245:Core/Src/main.c ****           auto_ctl.rightDistance = Distance;
 246:Core/Src/main.c ****         }
 247:Core/Src/main.c ****       }
 248:Core/Src/main.c **** 
 249:Core/Src/main.c ****       // set polarity to rising edge
 250:Core/Src/main.c ****       __HAL_TIM_SET_CAPTUREPOLARITY(htim, TIM_CHANNEL_1, TIM_INPUTCHANNELPOLARITY_RISING);
 251:Core/Src/main.c ****       __HAL_TIM_DISABLE_IT(&htim1, TIM_IT_CC1);
 252:Core/Src/main.c ****     }
 253:Core/Src/main.c ****   }
 254:Core/Src/main.c **** }
