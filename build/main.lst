 144:Core/Src/main.c ****     L_dt = now - L_t;
 145:Core/Src/main.c ****     L_t = now;
 146:Core/Src/main.c ****     ++left_ticks;
 147:Core/Src/main.c ****     // turning_ticks += (goingDirection == RIGHT || goingDirection == BACK) ? 1:0;
ARM GAS  /tmp/ccKW35Vz.s 			page 4


 148:Core/Src/main.c ****     auto_ctl.turning_ticks += (auto_ctl.goingDirection == RIGHT || auto_ctl.goingDirection == BACK)
